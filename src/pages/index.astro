---
const buildId = import.meta.env.PUBLIC_VOICEAR_BUILD;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="no-referrer" />
    <meta name="voicear-build" content={buildId} />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; connect-src 'self' https: wss: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; img-src 'self' blob:; media-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; manifest-src 'self'" />
    <link rel="stylesheet" href={`/global.css?v=${buildId}`} />
    <link rel="manifest" href={`/manifest.webmanifest?v=${buildId}`} />
    <link rel="apple-touch-icon" href={`/icon-192.png?v=${buildId}`} />
    <title>Voicear</title>
  </head>
  <body>
    <div id="camera-layer" aria-hidden="true">
      <video id="camera-feed" autoplay muted playsinline aria-hidden="true"></video>
    </div>

    <header>
      <time id="date"></time>
      <time id="clock"></time>
      <div id="header-actions">
        <span id="status" role="status">VOICE: STARTING</span>
        <button id="inbox-button" class="quiet hidden" type="button" aria-haspopup="dialog" aria-controls="inbox-dialog" aria-label="Agent-Inbox öffnen">
          <span aria-hidden="true">[ ▣ ]</span>
          <span id="inbox-dot" class="hidden" aria-hidden="true"></span>
        </button>
        <span id="inbox-status" class="sr-only" role="status"></span>
      </div>
    </header>
    <p id="notice" role="status" aria-live="polite"></p>

    <main id="transcript" role="log" aria-live="polite" aria-label="Gesprächsverlauf">
      <button id="older-transcript" class="quiet hidden" type="button" aria-label="Ältere Nachrichten und Fotos anzeigen">[ OLDER ]</button>
    </main>

    <section id="camera-controls" aria-label="Kamerasteuerung" aria-describedby="camera-privacy-help">
      <div class="camera-control-head">
        <span id="camera-status" role="status" aria-live="polite" aria-atomic="true">CAMERA: OFF</span>
        <small aria-hidden="true">PREVIEW + PHOTOS LOCAL · SHARE NEEDS ACTION</small>
        <span id="camera-privacy-help" class="sr-only">Kameravorschau und Fotos bleiben lokal. Ein gespeichertes Foto wird nur über Send to Agent oder nach einem ausdrücklichen Sprachbefehl und deiner Bestätigung übertragen. Ein aktuelles Kamerabild wird nur nach einer visuellen Frage und deiner Bestätigung übertragen.</span>
      </div>
      <div class="camera-control-actions">
        <button id="camera-feed-toggle" class="quiet" type="button" aria-pressed="false" aria-controls="camera-layer" aria-describedby="camera-feed-help">[ FEED ]</button>
        <span id="camera-feed-help" class="sr-only">Blendet nur die Vorschau ein oder aus. Die Kamera bleibt aktiv.</span>
        <button id="camera-photo" class="quiet" type="button" aria-label="Foto lokal aufnehmen">[ PHOTO ]</button>
        <label class="camera-opacity-control" for="camera-opacity">
          <span>OPACITY <output id="camera-opacity-value" for="camera-opacity">35%</output></span>
          <input id="camera-opacity" type="range" min="0" max="100" step="5" value="35" aria-label="Deckkraft des Kamerahintergrunds" />
        </label>
      </div>
    </section>

    <nav class="bottom" aria-label="App-Steuerung">
      <button id="current" class="quiet hidden" type="button">[ CURRENT VOICE ]</button>
      <button id="chats-button" class="quiet" type="button" aria-controls="sidebar" aria-expanded="false">[ CHATS ]</button>
      <button id="camera-button" class="quiet" type="button" aria-pressed="false" aria-controls="camera-layer camera-controls">[ CAMERA ]</button>
      <button id="fullscreen" class="quiet hidden" type="button">[ FULLSCREEN ]</button>
      <button id="voice-button" class="quiet" type="button" aria-pressed="false" aria-label="Realtime Voice Mode starten">[ VOICE ]</button>
    </nav>

    <aside id="sidebar" inert aria-hidden="true" aria-label="Chat-Verlauf">
      <div class="sidebar-head">
        <h1>CHATS</h1>
        <button id="close-sidebar" class="quiet" type="button" aria-label="Chat-Verlauf schließen">[ CLOSE ]</button>
      </div>
      <button id="new-chat" type="button">[ NEW CHAT ]</button>
      <ol id="chat-list"></ol>
      <div class="sidebar-actions">
        <button id="agents-button" class="quiet" type="button">[ LOCAL AGENTS ]</button>
        <button id="settings-button" class="quiet" type="button">[ KEYS + SETTINGS ]</button>
        <button id="export-button" class="quiet" type="button">[ EXPORT HISTORY ]</button>
      </div>
    </aside>

    <dialog id="inbox-dialog" aria-labelledby="inbox-title">
      <div class="dialog-shell">
        <div class="dialog-head">
          <h1 id="inbox-title">AGENT INBOX</h1>
          <button id="close-inbox" class="quiet" type="button" aria-label="Agent-Inbox schließen">[ CLOSE ]</button>
        </div>
        <p id="inbox-empty" class="warning">NO AGENT MESSAGES.</p>
        <ol id="inbox-list"></ol>
      </div>
    </dialog>

    <dialog id="agents-dialog" aria-labelledby="agents-title">
      <div class="dialog-shell">
        <div class="dialog-head">
          <h1 id="agents-title">LOCAL AGENTS</h1>
          <button id="close-agents" class="quiet" type="button" aria-label="Agent-Einstellungen schließen">[ CLOSE ]</button>
        </div>
        <p class="warning">OPTIONAL: Voice funktioniert vollständig ohne lokalen Agent. Verbindungen und Aufträge bleiben in diesem Browser gespeichert. Agent-Schlüssel sind BYOK und für JavaScript derselben Origin auslesbar. Schlüssel nur einfügen – niemals diktieren.</p>
        <ol id="agent-list"></ol>
        <form id="agent-form" autocomplete="off">
          <input id="agent-id" type="hidden" />
          <label>
            TYPE
            <select id="agent-kind" required>
              <option value="hermes">HERMES — STABLE RUNS API</option>
              <option value="openclaw">OPENCLAW — OFFICIAL WS BETA</option>
            </select>
          </label>
          <label>
            NAME
            <input id="agent-label" type="text" required maxlength="60" placeholder="WORKSTATION" />
          </label>
          <label>
            ENDPOINT
            <input id="agent-endpoint" type="url" required spellcheck="false" placeholder="https://agent.example.ts.net" />
          </label>
          <label id="agent-target-row" class="hidden">
            OPENCLAW AGENT ID
            <input id="agent-target" type="text" maxlength="80" spellcheck="false" placeholder="main" />
          </label>
          <label>
            <span id="agent-secret-label">HERMES API KEY</span>
            <input id="agent-secret" type="password" spellcheck="false" autocomplete="new-password" maxlength="8192" placeholder="Leer lassen, um den gespeicherten Schlüssel zu behalten" />
          </label>
          <label class="check-label">
            <input id="agent-default" type="checkbox" />
            DEFAULT FOR VOICE
          </label>
          <p id="agent-setup-help" class="warning"></p>
          <p id="agent-error" role="alert"></p>
          <div class="dialog-actions">
            <button id="save-agent" type="submit">[ SAVE + CONNECT ]</button>
            <button id="reset-agent" class="quiet" type="button">[ NEW ]</button>
          </div>
        </form>
      </div>
    </dialog>

    <dialog id="settings-dialog" aria-labelledby="settings-title">
      <form id="settings-form" method="dialog" autocomplete="off">
        <h1 id="settings-title">KEYS + SETTINGS</h1>
        <p class="warning">FRONTEND-ONLY BYOK: Der OpenAI Platform API Key wird dauerhaft im localStorage dieses Browsers gespeichert und ist für JavaScript derselben Origin auslesbar. Eine iOS-Home-Screen-App hat einen eigenen, von Safari getrennten Speicher; der Key muss dort separat gespeichert werden. Er wird nicht in Chats, IndexedDB oder Service Worker gespeichert. „Hey Jarvis“ wird lokal erkannt; erst danach startet OpenAI Realtime.</p>
        <label>
          OPENAI PLATFORM API KEY
          <input id="openai-key" name="openai" type="password" spellcheck="false" required minlength="20" placeholder="sk-proj-… oder ek_…" />
        </label>
        <label>
          VOICE MODEL
          <select id="model" name="model">
            <option value="gpt-realtime-2.1-mini">GPT-REALTIME-2.1-MINI — EFFICIENT</option>
            <option value="gpt-realtime-2.1">GPT-REALTIME-2.1 — QUALITY</option>
          </select>
        </label>
        <p class="warning">WAKE WORD: openWakeWord „Hey Jarvis“, lokal im Browser. Vortrainiertes Modell: CC BY-NC-SA 4.0.</p>
        <p id="settings-error" role="alert"></p>
        <div class="dialog-actions">
          <button id="save-settings" value="save" type="submit">[ SAVE ]</button>
          <button id="clear-keys" class="quiet" type="button">[ CLEAR KEYS ]</button>
          <button id="cancel-settings" class="quiet" type="button">[ CANCEL ]</button>
        </div>
      </form>
    </dialog>

    <audio id="agent-audio" autoplay></audio>
    <script src="../scripts/app.ts"></script>
  </body>
</html>
